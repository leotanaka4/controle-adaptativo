clc; clear; close all;

%% Definir Planta
kp = 0.1;
b = 3;
P = tf(kp*[1 b], [1 5 3]);

%% Definir Modelo
km = 1;
bm = 2;
M = tf(km*[1 bm], [1 2 1]);

%% Polinômio do Observador
A0 = 1; 

%% Rodar cálculo dos parâmetros ideais
[theta1, theta_n, theta2, theta_2n,Lambda] = controle2DOF(P, M, A0);

n=2;
Ap = fliplr([5 3]);
Bp = fliplr([b]);
Am = fliplr([2 1]);
Bm = fliplr([bm]);
ks = kp/km;
for i = 1:n-1
    k = n + 1 - i;

    % Safe access
    Bm_k = Bm(1); if length(Bm) >= k, Bm_k = Bm(k); end
    Bp_k = Bp(1); if length(Bp) >= k, Bp_k = Bp(k); end

    thetas(i) = Bm_k - Bp_k;
end
thetas(n) = (Ap(1) - Am(1))/kp;
for i=1:n-1
k = n + 1 - i;
thetas(n+i) = (Ap(k) - Am(k))/kp - thetas(n)*Bm(k);
end
thetas(2*n) = km/kp;
thetas